[alps]
desc       = unified package manager frontend
author     = adrianpriza-ai
version    = 0.9.7
arch       = x86_64, aarch64, armv7l
os         = linux, termux
sudo       = true

cmd_begin
  curl -fsSL https://alps-project.pages.dev/install.sh | sh
cmd_end
upgrade_begin
  curl -fsSL https://alps-project.pages.dev/install.sh | sh
upgrade_end
remove_begin
  curl -fsSL https://alps-project.pages.dev/uninstall.sh | sh
remove_end
purge_begin
  curl -fsSL https://alps-project.pages.dev/uninstall.sh | sh -s -- --purge
purge_end
