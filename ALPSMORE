[alps-test]
desc       = unified package manager frontend
author     = adrianpriza-ai
version    = 1.0.5
arch       = x86_64, aarch64, armv7l
os         = linux, termux
sudo       = true
safety     = free

cmd_begin
  {BASH_RUN} https://alps-project.pages.dev/install.sh
cmd_end
upgrade_begin
  {BASH_RUN} https://alps-project.pages.dev/install.sh
